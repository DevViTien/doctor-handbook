# Copy to `.env.local` for local development. Never commit real values.
# On Vercel, set these per environment (Production vs Preview MUST use different databases).

# --- Database (Supabase PostgreSQL) -------------------------------------------
# Runtime connection: Supabase *transaction pooler* (port 6543), suited to serverless.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres"
# Migrations & scripts: *session pooler* or direct connection (port 5432).
DIRECT_DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"

# --- Storage (Supabase Storage, private buckets) ------------------------------
SUPABASE_URL="https://<project-ref>.supabase.co"
# Server-only secret. NEVER prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=""

# --- Auth ----------------------------------------------------------------------
# HMAC key for activation / password-reset codes. Min 32 chars, keep it out of the database.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Rotating it invalidates codes that are still outstanding (they live 72 hours at most).
ACCESS_CODE_PEPPER=""

# --- Cron ----------------------------------------------------------------------
# Vercel sends `Authorization: Bearer <CRON_SECRET>` to cron routes. Min 16 chars.
# Required in Vercel production (the app refuses to start without it there).
CRON_SECRET=""

# --- Admin bootstrap (used only by `pnpm db:seed-admin`) -----------------------
ADMIN_USERNAME="admin"
ADMIN_PASSWORD=""
ADMIN_DISPLAY_NAME="Administrator"
